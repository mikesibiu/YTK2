# Managed PostgreSQL connection (Neon recommended)
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DB?sslmode=require

PORT=8080
NODE_ENV=production

# Number of reverse proxies in front of the app (Koyeb = 1). Needed for correct client IPs
# (rate limiting) and for Secure cookies.
TRUST_PROXY=1

# Admin UI + /api/admin/* (HTTP Basic). REQUIRED in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now

# Google OAuth client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_REDIRECT_URI=https://YOUR_HOST/api/admin/google/callback

# Encrypts the stored refresh token (AES-256-GCM). 32 random bytes, base64 or 64 hex chars.
#   openssl rand -base64 32
# REQUIRED in production. Losing it just means the parent has to sign in again.
TOKEN_ENCRYPTION_KEY=

# Access code the child types to open the UI (default 6969). Cookie signing uses SESSION_SECRET,
# or TOKEN_ENCRYPTION_KEY when that is unset.
CHILD_ACCESS_CODE=6969   # REQUIRED in production (no silent default there)
# SESSION_SECRET=

# Optional tuning (defaults shown)
# RATE_LIMIT_PER_MIN=120          # all public /api/* routes, per IP
# SEARCH_RATE_LIMIT_PER_MIN=20    # /api/search, per IP
# ADMIN_RATE_LIMIT_PER_MIN=120    # /admin and /api/admin, per IP
# SEARCH_CACHE_TTL_SECONDS=600
# FEED_CACHE_TTL_SECONDS=900      # subscriptions feed and playlists
# YOUTUBE_DAILY_QUOTA_BUDGET=9000 # soft in-memory cap on units/day (Google default quota is 10000)
# SUBSCRIPTION_MAX_CHANNELS=50
# SUBSCRIPTION_VIDEOS_PER_CHANNEL=5
# RESULT_LIMIT=24
# YOUTUBE_REGION_CODE=US
